<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>opensim_metaverse2mcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Set to 'true' to use local LibreMetaverse Git instead of NuGet packages -->
    <UseLibreMetaverseGit>false</UseLibreMetaverseGit>
  </PropertyGroup>

  <ItemGroup Condition="'$(UseLibreMetaverseGit)' != 'true'">
    <!-- Official NuGet packages -->
    <PackageReference Include="LibreMetaverse" Version="3.1.8" />
    <PackageReference Include="LibreMetaverse.RLV" Version="3.1.8" />
    <PackageReference Include="LibreMetaverse.Imaging.Skia" Version="3.1.8" />
    <PackageReference Include="LibreMetaverse.Voice.WebRTC" Version="3.1.8" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseLibreMetaverseGit)' == 'true'">
    <!-- Local fork projects -->
    <ProjectReference Include="../../libremetaverse/LibreMetaverse/LibreMetaverse.csproj" />
    <ProjectReference Include="../../libremetaverse/LibreMetaverse.RLV/LibreMetaverse.RLV.csproj" />
    <ProjectReference Include="../../libremetaverse/LibreMetaverse.Imaging.Skia/LibreMetaverse.Imaging.Skia.csproj" />
    <ProjectReference Include="../../libremetaverse/LibreMetaverse.Voice.WebRTC/LibreMetaverse.Voice.WebRTC.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../lsl/**/*"
          Link="lsl/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
